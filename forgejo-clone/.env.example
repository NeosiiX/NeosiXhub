# ─────────────────────────────────────────────
# DevHub — Variables d'environnement
# Copiez ce fichier en .env.local pour le dev
# Railway définit ces variables automatiquement
# ─────────────────────────────────────────────

# Base de données PostgreSQL (fournie par Railway)
DATABASE_URL="postgresql://user:password@localhost:5432/devhub"

# Clé secrète JWT — changez ABSOLUMENT en production (min 32 caractères)
JWT_SECRET="changez-moi-en-production-minimum-32-caracteres"

# Répertoire de stockage des dépôts Git (chemin absolu)
# Sur Railway, utilisez un volume persistant monté sur /data
GIT_ROOT="/git-repos"

# Environnement
NODE_ENV="development"

# URL publique du site (sans slash final)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
